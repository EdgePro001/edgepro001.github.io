---
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const posts = (await getCollection("blog")).filter((post) => includeDrafts || !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const includeDrafts = import.meta.env.DEV;
const allPosts = (await getCollection("blog")).filter((entry) => includeDrafts || !entry.data.draft);
const translationKey = post.data.translationKey ?? post.id;
const translations = allPosts.filter(
  (entry) =>
    entry.id !== post.id &&
    (entry.data.translationKey ?? entry.id) === translationKey
);
const variants = [post, ...translations].sort(
  (a, b) => (a.data.lang === "zh" ? -1 : 1) - (b.data.lang === "zh" ? -1 : 1)
);

const languageLabel = (lang: "en" | "zh") => (lang === "zh" ? "中文" : "English");

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<!doctype html>
<html lang={post.data.lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={post.data.description}>
    <title>{post.data.title} - Junxian Ma</title>
    {variants.map((entry) => (
      <link
        rel="alternate"
        hreflang={entry.data.lang === "zh" ? "zh-CN" : "en"}
        href={`/blog/${entry.id}/`}
      />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/styles.css?v=13">
  </head>
  <body>
    <img class="page-mark" src="/edge-mark.svg" alt="" aria-hidden="true">
    <main class="container post" aria-label={post.data.title}>
      <p>
        <a href="/">Junxian Ma</a> / <a href="/blog/">Writings</a>
      </p>

      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="muted">
          {formatDate(post.data.date)}
          {post.data.draft && <span class="draft-tag">Draft</span>}
        </p>
      </header>

      <Content />
    </main>

    {variants.length > 1 && (
      <nav class="language-switch language-switch--floating" aria-label="Article language">
        {variants.map((entry) =>
          entry.id === post.id ? (
            <span class="is-active" aria-current="page" lang={entry.data.lang === "zh" ? "zh-CN" : "en"}>
              {languageLabel(entry.data.lang)}
            </span>
          ) : (
            <a href={`/blog/${entry.id}/`} lang={entry.data.lang === "zh" ? "zh-CN" : "en"}>
              {languageLabel(entry.data.lang)}
            </a>
          )
        )}
      </nav>
    )}
    <button class="theme-toggle" type="button" aria-label="Toggle color mode">Mode</button>
    <script is:inline src="/script.js?v=7"></script>
  </body>
</html>
