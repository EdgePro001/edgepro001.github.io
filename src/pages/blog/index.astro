---
import { getCollection } from "astro:content";

const includeDrafts = import.meta.env.DEV;
const posts = (await getCollection("blog"))
  .filter((post) => includeDrafts || !post.data.draft);

const groupedPosts = new Map<string, typeof posts>();

for (const post of posts) {
  const key = post.data.translationKey ?? post.id;
  groupedPosts.set(key, [...(groupedPosts.get(key) ?? []), post]);
}

const postGroups = [...groupedPosts.values()]
  .map((entries) => {
    const variants = entries.sort((a, b) => (a.data.lang === "zh" ? -1 : 1) - (b.data.lang === "zh" ? -1 : 1));
    const primary = variants.find((entry) => entry.data.lang === "en") ?? variants[0];
    const date = new Date(Math.max(...variants.map((entry) => entry.data.date.valueOf())));
    return { date, primary };
  })
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });

const categoryLabel = (category: "technical" | "reflection") =>
  category === "technical" ? "Technical" : "Reflection";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Writings by Junxian Ma.">
    <title>Writings - Junxian Ma</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/styles.css?v=14">
  </head>
  <body>
    <img class="page-mark" src="/edge-mark.svg" alt="" aria-hidden="true">
    <main class="container" aria-label="Writings by Junxian Ma">
      <p>
        <a href="/">Junxian Ma</a> / Writings
      </p>

      {postGroups.length > 0 ? (
        <ul class="post-list">
          {postGroups.map(({ date, primary }) => (
            <li>
              <p class="post-list-title">
                <a
                  class={`post-title--${primary.data.category}`}
                  href={`/blog/${primary.id}/`}
                >
                  {primary.data.title}
                </a>
              </p>
              <p class="post-list-meta">
                <span>{formatDate(date)}</span>
                <span class={`post-category post-category--${primary.data.category}`}>
                  {categoryLabel(primary.data.category)}
                </span>
                <span
                  class="view-count"
                  data-view-key={`/blog/${primary.data.translationKey ?? primary.id}`}
                  hidden
                ></span>
                {primary.data.draft && <span class="draft-tag">Draft</span>}
              </p>
              <p>{primary.data.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p>No posts yet.</p>
      )}
    </main>

    <button class="theme-toggle" type="button" aria-label="Toggle color mode">Mode</button>
    <script defer src="/views.js?v=1"></script>
    <script is:inline src="/script.js?v=7"></script>
  </body>
</html>
